# Copy to .env and replace these placeholders. Never commit .env.
DB_NAME=fleetflow
DB_USER=fleetflow
DB_PASSWORD=replace-with-a-long-random-local-password
DB_PORT=5433
APP_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5433/fleetflow
OIDC_PORT=8081
OIDC_ISSUER=http://127.0.0.1:8081/realms/fleetflow
OIDC_JWKS_URI=http://127.0.0.1:8081/realms/fleetflow/protocol/openid-connect/certs
OIDC_AUDIENCE=fleetflow-api
KC_ADMIN_USER=replace-with-local-admin-name
KC_ADMIN_PASSWORD=replace-with-a-long-random-local-password
# App connects to the private Compose Redis service. Host-run app uses these defaults.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
KAFKA_PORT=9094
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_SWEEP_INTERVAL_MS=5000
OUTBOX_LEASE_DURATION=30s
OUTBOX_SEND_TIMEOUT=5s
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_PUBLISHED_RETENTION=30d
OUTBOX_PRUNE_BATCH_SIZE=500
OUTBOX_PRUNE_INTERVAL_MS=3600000
# Phase 7 offer expiry worker. Defaults shown; no external scheduler is needed.
RECOVERY_ENABLED=true
RECOVERY_BATCH_SIZE=50
RECOVERY_SWEEP_INTERVAL_MS=5000
RATE_READ_LIMIT=60
RATE_EXPENSIVE_READ_LIMIT=30
RATE_COMMAND_LIMIT=30
RATE_STREAM_LIMIT=6
RATE_DEMO_WRITE_LIMIT=5
# Keep disabled until a trusted ADMIN actor and demo persona OIDC subjects are provisioned.
DEMO_ENABLED=false
DEMO_OIDC_ISSUER=http://127.0.0.1:8081/realms/fleetflow
DEMO_CUSTOMER_SUBJECT=fleetflow-demo-customer
DEMO_MERCHANT_SUBJECT=fleetflow-demo-merchant
DEMO_DRIVER_SUBJECT=fleetflow-demo-driver

# Optional compose.monitoring.yaml local Grafana credentials and loopback port.
GRAFANA_ADMIN_USER=replace-with-local-monitoring-admin
GRAFANA_SECRET_FILE=.env.grafana-credential
GRAFANA_PORT=3000
