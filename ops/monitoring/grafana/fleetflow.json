    {
      "id": 10,
      "type": "timeseries",
      "title": "Derived effect rate",
      "description": "fleetflow.events.projected counter; committed consumer effect/ignored rate by fixed consumer and outcome labels.",
      "gridPos": {
        "h": 8,
        "w": 12,
