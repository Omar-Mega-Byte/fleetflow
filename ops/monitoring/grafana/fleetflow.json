{
  "uid": "fleetflow-local-ops",
  "title": "FleetFlow / local operations",
  "description": "Synthetic local demo only. Read top row for dependency and queue state, then follow API, outbox, and recovery panels. Values and limits are defined in docs/operations/PHASE11_BASELINE.md.",
  "tags": [
    "fleetflow",
    "local-demo",
    "operations"
  ],
  "timezone": "utc",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics scrape",
      "description": "Prometheus up{job=\"fleetflow\"}; 1 means the private management port is reachable.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleetflow-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"fleetflow\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL",
      "description": "fleetflow.operations.database.available; refreshed every 15 seconds from a bounded SQL snapshot.",
