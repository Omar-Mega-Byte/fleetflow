# conf.d is included in the http context. Never log OIDC queries or bearer headers.
map $uri $fleetflow_route { default web; ~^/api/ api; ~^/realms/ identity; ~^/resources/ identity_assets; }
map $request_method $login_key { default ""; POST $binary_remote_addr; }
map $status $retry_after { default ""; 429 15; }
log_format fleetflow escape=json '{"time":"$time_iso8601","requestId":"$request_id","method":"$request_method","route":"$fleetflow_route","status":$status,"duration":$request_time}';
access_log /dev/stdout fleetflow;
error_log /dev/stderr crit;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=identity:10m rate=5r/s;
limit_req_zone $login_key zone=login:1m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=connections:10m;
limit_req_status 429;
limit_conn_status 429;
client_header_timeout 10s;
client_body_timeout 10s;
send_timeout 30s;
keepalive_timeout 30s;
large_client_header_buffers 2 8k;
server_tokens off;

server { listen 80 default_server; server_name _; return 444; }
server { listen 80; server_name ${DEMO_HOST} ${IDENTITY_HOST}; return 301 https://$host$request_uri; }
server {
    listen 8081;
    server_name localhost;
    location = /healthz { access_log off; default_type text/plain; return 200 'ok'; }
    location / { return 404; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /run/secrets/tls_fullchain;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${DEMO_HOST};
    ssl_certificate /run/secrets/tls_fullchain;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 1m;
    limit_conn connections 30;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    add_header Retry-After $retry_after always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://${IDENTITY_HOST}; script-src 'self'; style-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://${IDENTITY_HOST}" always;
    error_page 413 = @too_large;
    error_page 429 = @limited;
    location @too_large {
        default_type application/json;
        return 413 '{"code":"PAYLOAD_TOO_LARGE","message":"Request body exceeds the allowed size","path":"/api","timestamp":"$time_iso8601","correlationId":"$request_id","fields":[]}';
    }
    location @limited {
        default_type application/json;
        return 429 '{"code":"RATE_LIMITED","message":"Request rate exceeded","path":"/api","timestamp":"$time_iso8601","correlationId":"$request_id","fields":[]}';
    }
    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }
    location = /swagger-ui { return 404; }
    location ^~ /swagger-ui/ { return 404; }
    location ^~ /v3/api-docs { return 404; }
    location ^~ /.git/ { return 404; }

    location = /runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 'window.__FLEETFLOW_CONFIG__ = Object.freeze({ oidcAuthority: "https://${IDENTITY_HOST}/realms/fleetflow" });';
    }

    location ~ "^/api/v1/orders/[0-9a-fA-F-]{36}/tracking/stream$" {
        limit_req zone=api burst=40 nodelay;
        limit_conn connections 12;
        proxy_pass http://app:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 360s;
        proxy_buffering off;
        proxy_cache off;
    }
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://app:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 30s;
    }
    root /usr/share/nginx/html;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${IDENTITY_HOST};
    ssl_certificate /run/secrets/tls_fullchain;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 1m;
    limit_conn connections 30;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Retry-After $retry_after always;
    location ^~ /admin/ { return 404; }
    location ^~ /realms/master/ { return 404; }
    location = /health { return 404; }
    location = /health/ready { return 404; }
    location = /health/live { return 404; }
    location = /metrics { return 404; }
    location ~ ^/realms/fleetflow/login-actions/ {
        limit_req zone=identity burst=20 nodelay;
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://keycloak:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 30s;
    }
    location /realms/fleetflow/ {
        limit_req zone=identity burst=20 nodelay;
        proxy_pass http://keycloak:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 30s;
    }
    location ^~ /resources/ {
        proxy_pass http://keycloak:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
